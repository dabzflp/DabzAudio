PORT=3000
APP_BASE_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/
MONGODB_DB=dabzaudio_registry

# Blockchain
# Recommended test network for development: Polygon Amoy.
BLOCKCHAIN_ENABLED=false
